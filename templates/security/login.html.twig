{% extends 'base.html.twig' %}

{% block title %}Logowanie — Admin{% endblock %}

{% block body %}
<section class="admin-login container" aria-labelledby="login-heading">
    <h1 id="login-heading">Logowanie administratora</h1>

    {% if error %}
        <p class="admin-login__error" role="alert">Nieprawidłowy e-mail lub hasło.</p>
    {% endif %}

    <form method="post" class="admin-login__form" novalidate>
        <div class="admin-login__field">
            <label for="email">E-mail</label>
            <input
                type="email"
                id="email"
                name="email"
                value="{{ last_username }}"
                autocomplete="username"
                required
                autofocus
            >
        </div>

        <div class="admin-login__field">
            <label for="password">Hasło</label>
            <input
                type="password"
                id="password"
                name="password"
                autocomplete="current-password"
                required
            >
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit">Zaloguj się</button>
    </form>
</section>
{% endblock %}
