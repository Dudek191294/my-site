<footer class="site-footer">
    <div class="container site-footer__inner">
        <p class="site-footer__brand">{{ site ? site.siteName : 'Portfolio' }}</p>
        <p class="site-footer__copy">&copy; {{ "now"|date("Y") }} {{ site ? site.siteName : 'Portfolio' }}. Wszelkie prawa zastrzeżone.</p>
        {% if socialLinks|length > 0 %}
            <ul class="site-footer__links">
                {% for link in socialLinks %}
                    <li>
                        <a href="{{ link.url }}"{% if link.platform != 'email' %} rel="noopener noreferrer"{% endif %}>{{ link.label }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</footer>
