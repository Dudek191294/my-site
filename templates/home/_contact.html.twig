<section id="contact" class="section contact" aria-labelledby="contact-heading" data-reveal>
    <div class="container section__inner section__inner--narrow">
        <header class="section__header">
            <h2 id="contact-heading" class="section__title">Let's build something.</h2>
            <p class="section__intro">
                [Short message — open to collaborations, product work, or a quick technical chat.]
            </p>
        </header>

        <ul class="contact__channels">
            <li>
                <span class="contact__label">Email</span>
                <a href="mailto:[EMAIL]">[EMAIL]</a>
            </li>
            <li>
                <span class="contact__label">LinkedIn</span>
                <a href="[LINKEDIN_URL]" rel="noopener noreferrer">[LINKEDIN_URL]</a>
            </li>
            <li>
                <span class="contact__label">GitHub</span>
                <a href="[GITHUB_URL]" rel="noopener noreferrer">[GITHUB_URL]</a>
            </li>
        </ul>

        <p class="contact__cta">
            <a class="btn btn--primary" href="mailto:[EMAIL]">Get in touch</a>
        </p>
    </div>
</section>
