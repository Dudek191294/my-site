<section id="contact" class="section contact" aria-labelledby="contact-heading" data-reveal>
    <div class="container section__inner section__inner--narrow">
        <header class="section__header">
            <h2 id="contact-heading" class="section__title">Zbudujmy coś razem.</h2>
            {% if site and site.contactIntro %}
                <p class="section__intro">{{ site.contactIntro }}</p>
            {% endif %}
        </header>

        {% if socialLinks|length > 0 %}
            <ul class="contact__channels">
                {% for link in socialLinks %}
                    <li>
                        <span class="contact__label">{{ link.label }}</span>
                        <a href="{{ link.url }}"{% if link.platform != 'email' %} rel="noopener noreferrer"{% endif %}>{{ link.url }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {% if site and site.contactEmail %}
            <p class="contact__cta">
                <a class="btn btn--primary" href="mailto:{{ site.contactEmail }}">Napisz do mnie</a>
            </p>
        {% endif %}
    </div>
</section>
