<section class="hero" aria-labelledby="hero-heading">
    <div class="container hero__inner">
        <p class="hero__eyebrow">[ROLE]</p>
        <h1 id="hero-heading" class="hero__title">[HEADLINE]</h1>
        <p class="hero__positioning">[POSITIONING — one or two sentences about what you build and for whom.]</p>
        <div class="hero__actions">
            <a class="btn btn--primary" href="{{ path('home') }}#work">View my work</a>
            <a class="btn btn--secondary" href="{{ path('home') }}#contact">Get in touch</a>
        </div>
        <ul class="hero__social">
            <li><a href="[GITHUB_URL]" rel="noopener noreferrer">GitHub</a></li>
            <li><a href="[LINKEDIN_URL]" rel="noopener noreferrer">LinkedIn</a></li>
            <li><a href="mailto:[EMAIL]">Email</a></li>
        </ul>
        <p class="hero__meta">[LOCATION] · [AVAILABILITY]</p>
    </div>
</section>
