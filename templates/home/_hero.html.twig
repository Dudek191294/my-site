<section class="hero" aria-labelledby="hero-heading">
    <div class="container hero__layout">
        <div class="hero__inner">
            {% if site %}
                {% if site.roleTitle %}
                    <p class="hero__eyebrow">{{ site.roleTitle }}</p>
                {% endif %}
                <h1 id="hero-heading" class="hero__title">{{ site.headline }}</h1>
                {% if site.positioning %}
                    <p class="hero__positioning">{{ site.positioning }}</p>
                {% endif %}
            {% else %}
                <h1 id="hero-heading" class="hero__title">Portfolio</h1>
            {% endif %}
            <div class="hero__actions">
                <a class="btn btn--primary" href="{{ path('home') }}#work">Zobacz realizacje</a>
                <a class="btn btn--secondary" href="{{ path('home') }}#contact">Napisz do mnie</a>
            </div>
            {% if socialLinks|length > 0 %}
                <ul class="hero__social">
                    {% for link in socialLinks %}
                        <li>
                            <a href="{{ link.url }}"{% if link.platform != 'email' %} rel="noopener noreferrer"{% endif %}>{{ link.label }}</a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
            {% set heroMeta = [] %}
            {% if site and site.location %}
                {% set heroMeta = heroMeta|merge([site.location]) %}
            {% endif %}
            {% if site and site.availability %}
                {% set heroMeta = heroMeta|merge([site.availability]) %}
            {% endif %}
            {% if heroMeta|length > 0 %}
                <p class="hero__meta">{{ heroMeta|join(' · ') }}</p>
            {% endif %}
        </div>
        <figure class="hero__photo relative">
            <img
                src="/images/moje-removebg.png"
                alt="{{ site ? site.siteName : 'Portret' }}"
                width="800"
                height="1200"
                class="w-full h-full object-cover object-top
                       [mask-image:linear-gradient(to_bottom,black_40%,transparent_100%)]
                       [-webkit-mask-image:linear-gradient(to_bottom,black_40%,transparent_100%)]"
            >
        </figure>
    </div>
</section>
