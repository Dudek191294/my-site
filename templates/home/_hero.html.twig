<section class="hero" aria-labelledby="hero-heading">
    <div class="container hero__inner">
        <p class="hero__eyebrow">{{ site ? site.roleTitle : '[ROLE]' }}</p>
        <h1 id="hero-heading" class="hero__title">{{ site ? site.headline : '[HEADLINE]' }}</h1>
        <p class="hero__positioning">{{ site ? site.positioning : '[POSITIONING — one or two sentences about what you build and for whom.]' }}</p>
        <div class="hero__actions">
            <a class="btn btn--primary" href="{{ path('home') }}#work">View my work</a>
            <a class="btn btn--secondary" href="{{ path('home') }}#contact">Get in touch</a>
        </div>
        <ul class="hero__social">
            {% if socialLinks is defined and socialLinks|length > 0 %}
                {% for link in socialLinks %}
                    <li>
                        <a href="{{ link.url }}"{% if link.platform != 'email' %} rel="noopener noreferrer"{% endif %}>{{ link.label }}</a>
                    </li>
                {% endfor %}
            {% else %}
                <li><a href="[GITHUB_URL]" rel="noopener noreferrer">GitHub</a></li>
                <li><a href="[LINKEDIN_URL]" rel="noopener noreferrer">LinkedIn</a></li>
                <li><a href="mailto:[EMAIL]">Email</a></li>
            {% endif %}
        </ul>
        <p class="hero__meta">
            {{ site and site.location ? site.location : '[LOCATION]' }}
            ·
            {{ site and site.availability ? site.availability : '[AVAILABILITY]' }}
        </p>
    </div>
</section>
