<section id="about" class="section about" aria-labelledby="about-heading" data-reveal>
    <div class="container section__inner section__inner--narrow">
        <header class="section__header">
            <h2 id="about-heading" class="section__title">O mnie</h2>
        </header>
        {% if site and site.aboutBody %}
            <div class="about__body">
                {% for paragraph in site.aboutBody|split('\n\n') %}
                    {% if paragraph|trim %}
                        <p>{{ paragraph|nl2br }}</p>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}
        {% set aboutMeta = [] %}
        {% if site and site.location %}
            {% set aboutMeta = aboutMeta|merge([site.location]) %}
        {% endif %}
        {% if site and site.workMode %}
            {% set aboutMeta = aboutMeta|merge([site.workMode]) %}
        {% endif %}
        {% if site and site.principles|length > 0 %}
            {% set aboutMeta = aboutMeta|merge(site.principles) %}
        {% endif %}
        {% if aboutMeta|length > 0 %}
            <ul class="about__meta">
                {% for item in aboutMeta %}
                    <li>{{ item }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</section>
