<section id="work" class="projects" aria-labelledby="work-heading" data-reveal>
    <div class="container">
        <header class="projects__header">
            <h2 id="work-heading" class="projects__title">Selected Work</h2>
            <p class="projects__intro">[Brief intro to your selected projects — or leave as placeholder.]</p>
        </header>
        <div class="projects__grid">
            {% for project in projects %}
                {% include 'home/_project_card.html.twig' with {project: project} only %}
            {% endfor %}
        </div>
    </div>
</section>
