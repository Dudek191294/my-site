<section id="work" class="projects" aria-labelledby="work-heading" data-reveal>
    <div class="container">
        <header class="projects__header">
            <h2 id="work-heading" class="projects__title">Wybrane realizacje</h2>
            {% if site and site.projectsIntro %}
                <p class="projects__intro">{{ site.projectsIntro }}</p>
            {% endif %}
        </header>
        {% if projects|length > 0 %}
            <div class="projects__grid">
                {% for project in projects %}
                    {% include 'home/_project_card.html.twig' with {project: project} only %}
                {% endfor %}
            </div>
        {% else %}
            <p class="text-muted m-0">Brak opublikowanych projektów.</p>
        {% endif %}
    </div>
</section>
