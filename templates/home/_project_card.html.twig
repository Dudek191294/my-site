<article class="project-card">
    <div class="project-card__visual" role="img" aria-label="{{ project.imageAlt|default('Project screenshot') }}">
        {% if project.image %}
            <img src="{{ project.image }}" alt="{{ project.imageAlt|default('') }}" loading="lazy" width="640" height="400">
        {% else %}
            <span class="project-card__placeholder">[SCREENSHOT]</span>
        {% endif %}
    </div>
    <div class="project-card__body">
        <h3 class="project-card__title">{{ project.title }}</h3>
        <p class="project-card__summary">{{ project.shortDescription }}</p>
        <ul class="project-card__stack">
            {% for item in project.stacks %}
                <li>{% include 'components/stack_item.html.twig' with { stack: item } only %}</li>
            {% endfor %}
        </ul>
        <ul class="project-card__links">
            {% if project.demoUrl %}
                <li><a href="{{ project.demoUrl }}">Demo</a></li>
            {% endif %}
            {% if project.githubUrl %}
                <li><a href="{{ project.githubUrl }}">GitHub</a></li>
            {% endif %}
            <li><a href="{{ path('project_show', {slug: project.slug}) }}">Case study</a></li>
        </ul>
    </div>
</article>
