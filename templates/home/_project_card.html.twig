<article class="project-card">
    <div class="project-card__visual"{% if project.imageUrl %} role="img" aria-label="{{ project.imageAlt|default('Zrzut ekranu projektu') }}"{% endif %}>
        {% if project.imageUrl %}
            <img src="{{ project.imageUrl }}" alt="{{ project.imageAlt|default('') }}" loading="lazy" width="640" height="400">
        {% endif %}
    </div>
    <div class="project-card__body">
        <h3 class="project-card__title">{{ project.title }}</h3>
        <p class="project-card__summary">{{ project.shortDescription }}</p>
        {% if project.stacks|length > 0 %}
            <ul class="project-card__stack">
                {% for item in project.stacks %}
                    <li>{% include 'components/technology_pill.html.twig' with { name: item.name, icon: item.icon, variant: 'primary' } only %}</li>
                {% endfor %}
            </ul>
        {% endif %}
        <ul class="project-card__links">
            {% if project.demoUrl %}
                <li><a href="{{ project.demoUrl }}">Demo</a></li>
            {% endif %}
            {% if project.githubUrl %}
                <li><a href="{{ project.githubUrl }}">GitHub</a></li>
            {% endif %}
            <li><a href="{{ path('project_show', {slug: project.slug}) }}">Studium przypadku</a></li>
        </ul>
    </div>
</article>
