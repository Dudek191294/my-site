<article class="project-card">
    {% if project.imageUrl %}
        <div class="project-card__visual" role="img" aria-label="{{ project.imageAlt|default('Zrzut ekranu projektu') }}">
            <img src="{{ project.imageUrl }}" alt="{{ project.imageAlt|default('') }}" loading="lazy" width="640" height="400">
        </div>
    {% endif %}
    <div class="project-card__body">
        <h3 class="project-card__title">{{ project.title }}</h3>
        <p class="project-card__summary">{{ project.shortDescription }}</p>
        {% if project.stacks|length > 0 %}
            <ul class="project-card__stack">
                {% for item in project.stacks %}
                    <li>{% include 'components/technology_pill.html.twig' with { name: item.name, icon: item.icon, variant: 'primary' } only %}</li>
                {% endfor %}
            </ul>
        {% endif %}
        {% if project.demoUrl or project.githubUrl or project.hasDetails %}
            <ul class="project-card__links">
                {% if project.demoUrl %}
                    <li>
                        <a class="btn btn--primary" href="{{ project.demoUrl }}">Zobacz</a>
                    </li>
                {% endif %}
                {% if project.githubUrl %}
                    <li>
                        <a class="btn btn--secondary" href="{{ project.githubUrl }}">GitHub</a>
                    </li>
                {% endif %}
                {% if project.hasDetails and project.slug %}
                    <li>
                        <a class="btn btn--ghost" href="{{ path('project_show', { slug: project.slug }) }}">Więcej</a>
                    </li>
                {% endif %}
            </ul>
        {% endif %}
    </div>
</article>
