{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} — Case Study{% endblock %}

{% block body %}
<article class="case-study" data-reveal>
    <div class="container case-study__inner">
        <p class="case-study__back">
            <a href="{{ path('home') }}#work">&larr; Back to Selected Work</a>
        </p>

        <header class="case-study__header">
            <p class="case-study__eyebrow">Project</p>
            <h1 class="case-study__title">{{ project.name }}</h1>
            <p class="case-study__summary">{{ project.summary }}</p>
        </header>

        <section class="case-study__section" aria-labelledby="overview-heading">
            <h2 id="overview-heading">Overview</h2>
            <p>{{ project.overview }}</p>
        </section>

        <section class="case-study__section" aria-labelledby="problem-heading">
            <h2 id="problem-heading">Problem</h2>
            <p>{{ project.problem }}</p>
        </section>

        <section class="case-study__section" aria-labelledby="solution-heading">
            <h2 id="solution-heading">Solution</h2>
            <p>{{ project.solution }}</p>
        </section>

        <section class="case-study__section" aria-labelledby="role-heading">
            <h2 id="role-heading">Role</h2>
            <p>{{ project.role }}</p>
        </section>

        <section class="case-study__section" aria-labelledby="architecture-heading">
            <h2 id="architecture-heading">Architecture</h2>
            <ol class="architecture-flow">
                <li>
                    <span class="architecture-flow__layer">Frontend</span>
                    <p>{{ project.architecture.frontend }}</p>
                </li>
                <li>
                    <span class="architecture-flow__layer">API</span>
                    <p>{{ project.architecture.api }}</p>
                </li>
                <li>
                    <span class="architecture-flow__layer">Backend</span>
                    <p>{{ project.architecture.backend }}</p>
                </li>
                <li>
                    <span class="architecture-flow__layer">Database</span>
                    <p>{{ project.architecture.database }}</p>
                </li>
                <li>
                    <span class="architecture-flow__layer">Infrastructure</span>
                    <p>{{ project.architecture.infrastructure }}</p>
                </li>
            </ol>
        </section>

        <section class="case-study__section" aria-labelledby="decisions-heading">
            <h2 id="decisions-heading">Technical Decisions</h2>
            <ul>
                {% for decision in project.technicalDecisions %}
                    <li>{{ decision }}</li>
                {% endfor %}
            </ul>
        </section>

        <section class="case-study__section" aria-labelledby="challenges-heading">
            <h2 id="challenges-heading">Challenges</h2>
            <ul>
                {% for challenge in project.challenges %}
                    <li>{{ challenge }}</li>
                {% endfor %}
            </ul>
        </section>

        <section class="case-study__section" aria-labelledby="result-heading">
            <h2 id="result-heading">Result</h2>
            <p>{{ project.result }}</p>
        </section>

        <section class="case-study__section" aria-labelledby="lessons-heading">
            <h2 id="lessons-heading">Lessons Learned</h2>
            <ul>
                {% for lesson in project.lessonsLearned %}
                    <li>{{ lesson }}</li>
                {% endfor %}
            </ul>
        </section>

        <section class="case-study__section" aria-labelledby="stack-heading">
            <h2 id="stack-heading">Tech Stack</h2>
            <ul class="case-study__stack">
                {% for tech in project.stack %}
                    <li>{{ tech }}</li>
                {% endfor %}
            </ul>
        </section>

        <section class="case-study__section" aria-labelledby="links-heading">
            <h2 id="links-heading">Links</h2>
            <ul class="case-study__links">
                <li><a href="{{ project.demoUrl }}">Demo</a></li>
                <li><a href="{{ project.githubUrl }}">GitHub</a></li>
            </ul>
        </section>
    </div>
</article>
{% endblock %}
