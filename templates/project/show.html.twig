{% extends 'base.html.twig' %}

{% block title %}{{ project.title }} — Projekt{% endblock %}

{% block body %}
<article class="case-study" data-reveal>
    <div class="container case-study__inner">
        <p class="case-study__back">
            <a href="{{ path('home') }}#work">&larr; Wróć do realizacji</a>
        </p>

        <header class="case-study__header">
            <p class="case-study__eyebrow">Projekt</p>
            <h1 class="case-study__title">{{ project.title }}</h1>
        </header>

        {% if project.imageUrl %}
            <p class="case-study__cover">
                <img src="{{ project.imageUrl }}" alt="{{ project.imageAlt|default(project.title) }}" width="960" height="600">
            </p>
        {% endif %}

        <section class="case-study__section" aria-labelledby="description-heading">
            <h2 id="description-heading">Opis projektu</h2>
            <p class="text-muted whitespace-pre-line">{{ project.description }}</p>
        </section>

        {% if project.role %}
            <section class="case-study__section" aria-labelledby="role-heading">
                <h2 id="role-heading">Rola</h2>
                <p class="text-muted">{{ project.role }}</p>
            </section>
        {% endif %}

        {% if project.challenge %}
            <section class="case-study__section" aria-labelledby="challenge-heading">
                <h2 id="challenge-heading">Wyzwanie</h2>
                <p class="text-muted whitespace-pre-line">{{ project.challenge }}</p>
            </section>
        {% endif %}

        {% if project.solution %}
            <section class="case-study__section" aria-labelledby="solution-heading">
                <h2 id="solution-heading">Rozwiązanie</h2>
                <p class="text-muted whitespace-pre-line">{{ project.solution }}</p>
            </section>
        {% endif %}

        {% if project.stacks|length > 0 %}
            <section class="case-study__section" aria-labelledby="stack-heading">
                <h2 id="stack-heading">Stack technologiczny</h2>
                <ul class="case-study__stack">
                    {% for item in project.stacks %}
                        <li>{% include 'components/technology_pill.html.twig' with { name: item.name, icon: item.icon, variant: 'primary' } only %}</li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {% if project.demoUrl or project.githubUrl %}
            <section class="case-study__section" aria-labelledby="links-heading">
                <h2 id="links-heading">Linki</h2>
                <ul class="case-study__links">
                    {% if project.demoUrl %}
                        <li>
                            <a class="btn btn--primary" href="{{ project.demoUrl }}">Zobacz</a>
                        </li>
                    {% endif %}
                    {% if project.githubUrl %}
                        <li>
                            <a class="btn btn--secondary" href="{{ project.githubUrl }}">GitHub</a>
                        </li>
                    {% endif %}
                </ul>
            </section>
        {% endif %}
    </div>
</article>
{% endblock %}
