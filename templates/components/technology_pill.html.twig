{# Reusable technology pill: optional SVG icon + name. #}
{% set variant = variant|default('neutral') %}
{% set iconSvg = icon ? stack_icon_svg(icon) : '' %}
{% set variantClasses = {
    primary: 'border-transparent bg-accent text-bg',
    success: 'border-success/30 bg-success/10 text-success',
    warning: 'border-warning/30 bg-warning/10 text-warning',
    danger: 'border-danger/30 bg-danger/10 text-danger',
    neutral: 'border-border bg-surface text-text',
} %}
<span class="inline-flex w-fit items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs leading-tight {{ variantClasses[variant]|default(variantClasses.neutral) }}">
    {% if iconSvg %}
        <span class="tech-pill__icon size-3.5 shrink-0" aria-hidden="true">{{ iconSvg|raw }}</span>
    {% endif %}
    <span>{{ name }}</span>
</span>
