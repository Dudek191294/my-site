{# Reusable technology pill: optional SVG icon + name. #}
{% set variant = variant|default('neutral') %}
{% set iconSvg = icon ? stack_icon_svg(icon) : '' %}
{% set variantClasses = {
    primary: 'border-accent/30 bg-accent/10 text-accent',
    success: 'border-success/30 bg-success/10 text-success',
    warning: 'border-warning/30 bg-warning/10 text-warning',
    danger: 'border-danger/30 bg-danger/10 text-danger',
    neutral: 'border-border bg-surface/60 text-text',
} %}
<span class="inline-flex w-fit items-center gap-1.5 rounded-full border px-2.5 py-1 text-[0.8125rem] leading-tight {{ variantClasses[variant]|default(variantClasses.neutral) }}">
    {% if iconSvg %}
        <span class="size-3.5 shrink-0 [&_svg]:block [&_svg]:size-full [&_svg]:fill-current" aria-hidden="true">{{ iconSvg|raw }}</span>
    {% endif %}
    <span>{{ name }}</span>
</span>
